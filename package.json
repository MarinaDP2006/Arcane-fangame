{
  "name": "arcane-fangame",
  "productName": "Arcane-fangame",
  "version": "1.30.1",
  "description": "Fangame narrativo de rol libre ambientado en Arcane, con Piltover, Zaun y personajes de las temporadas 1 y 2.",
  "main": "main.js",
  "author": "MarinaDP2006",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/asegurar-electron.js",
    "check": "node scripts/check.js && node scripts/check-runtime.js",
    "dist": "electron-builder --win",
    "dist:win": "electron-builder --win",
    "android:sync": "node scripts/build-mobile.js && cap sync android",
    "dist:mac": "electron-builder --mac",
    "web": "node scripts/build-web.js",
    "serve:web": "node server/roleplay-server.js"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.marinadp2006.arcanewikigame",
    "productName": "Arcane-fangame",
    "files": [
      "main.js",
      "modelos.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "package.json",
      "assets/music/**/*",
      "CREACION DE PERSONAJES, MENUS Y AJUSTES INSPIRACION.png",
      "INSPIRACION PANTALLAS SEGUN CIUDAD.png",
      "INSPIRACION MODELOS 3D.png",
      "COMO SE VERIAN LOS LUGARES, PANTALLAS Y PERSONAJE EN LAS CIUDADES (CIUDADES CUADRADAS).png",
      "INTERFAZ A MEJORAR DE CREACION Y USABILIDAD.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Arcane-fangame",
      "artifactName": "Arcane-fangame-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Arcane-fangame-${version}-portable.${ext}"
    },
    "mac": {
      "category": "public.app-category.role-playing-games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": null,
      "artifactName": "Arcane-fangame-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Arcane-fangame ${version}"
    }
  }
}
