# Variables exclusivas del servidor de roleplay web (server/roleplay-server.js).
# No configuran el proveedor de IA del juego de escritorio. El chat del juego de escritorio
# usa actualmente KoboldCpp; el perfil Ollama del cliente sigue desactivado y no está integrado.
# Configura estos valores en el alojamiento (por ejemplo, Render), nunca en el navegador ni en GitHub.
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b

# Alternativa para el servidor web: API compatible con OpenAI (por ejemplo, LM Studio).
# AI_BASE_URL=http://127.0.0.1:1234/v1
# AI_MODEL=<identificador-exacto-que-muestra-LM-Studio>
# AI_API_KEY= (vacío si el servidor no requiere autenticación)
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

ROLEPLAY_RPM=20
# Orígenes web permitidos, separados por comas (vacío = cualquiera).
ALLOWED_ORIGINS=
PORT=10000
